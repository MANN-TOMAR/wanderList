<% layout('/layouts/boilerplate.ejs') -%>

    <body>
        <br>
        <h1>All Listings!</h1>
        <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1">
        <% for (list of listings) { %>
        <a href="/listings/<%= list._id %>" class="listing-link">
        <div class="card listing-card col">
            <img src="<%= list.image %>" class="card-img-top" alt="Listing image" style="height: 20rem;">
            <div class="card-img-overlay"><%= list.description %></div>
            <div class="card-body">
                <p class="card-text"><b><%= list.title %></b><br>
                &#x20B9;<%= list.price.toLocaleString("en-IN") %>/night
                </p>
            </div>
        </div>
        </a>
        <% } %>
        </div>
    </body>