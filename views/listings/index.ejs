<% layout('/layouts/boilerplate.ejs') -%>

<div class="mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0">Explore All Listings</h2>
        <span class="text-muted fs-6"><%= listings.length %> stays available</span>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        <% for (list of listings) { %>
            <div class="col">
                <a href="/listings/<%= list._id %>" class="listing-link">
                    <div class="card listing-card h-100">
                        <img src="<%= list.image %>" class="card-img-top" alt="<%= list.title %>" loading="lazy">
                        <div class="card-body">
                            <p class="card-text">
                                <b><%= list.title %></b>
                                <span class="text-secondary small d-block"><%= list.location %>, <%= list.country %></span>
                                <span class="fw-semibold">&#x20B9;<%= list.price.toLocaleString("en-IN") %></span>
                                <span class="text-muted small"> / night</span>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
</div>
