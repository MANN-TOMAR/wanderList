<% layout('/layouts/boilerplate.ejs') -%>

<div class="row mt-3">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">
        <h2 class="fw-bold mb-4">Edit Listing</h2>

        <form action="/listings/<%= detail._id %>?_method=PATCH" method="post" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="title" class="form-label fw-semibold">Title</label>
                <input type="text" id="title" class="form-control" name="listing[title]" value="<%= detail.title %>" required>
                <div class="invalid-feedback">Please enter a title.</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label fw-semibold">Description</label>
                <textarea id="description" class="form-control" name="listing[description]" rows="4" required><%= detail.description %></textarea>
                <div class="invalid-feedback">Please enter a description.</div>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label fw-semibold">Image URL</label>
                <input type="text" id="image" class="form-control" name="listing[image]" value="<%= detail.image %>" required>
                <div class="invalid-feedback">Please enter a valid image URL.</div>
            </div>

            <div class="row">
                <div class="mb-3 col-12 col-md-4">
                    <label for="price" class="form-label fw-semibold">Price (&#x20B9; / night)</label>
                    <input type="number" id="price" class="form-control" name="listing[price]" value="<%= detail.price %>" min="0" required>
                    <div class="invalid-feedback">Please enter a valid price.</div>
                </div>

                <div class="mb-3 col-12 col-md-8">
                    <label for="location" class="form-label fw-semibold">Location</label>
                    <input type="text" id="location" class="form-control" name="listing[location]" value="<%= detail.location %>" required>
                    <div class="invalid-feedback">Please enter a location.</div>
                </div>
            </div>

            <div class="mb-4">
                <label for="country" class="form-label fw-semibold">Country</label>
                <input type="text" id="country" class="form-control" name="listing[country]" value="<%= detail.country %>" required>
                <div class="invalid-feedback">Please enter a country.</div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn edit-btn">Update Listing</button>
                <a href="/listings/<%= detail._id %>" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
