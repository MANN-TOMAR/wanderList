                <form action="/listings/<%= detail._id %>?_method=PATCH" method="post" novalidate
                    class="needs-validation">

                    <div class="mb-3">
                        <label for="title">Title</label>
                        <input type="text" class="form-control" name="listing[title]" placeholder="Enter Title"
                            value="<%= detail.title %>" required>
                        <div class="valid-feedback">
                            Validation Fulfilled!
                        </div>
                        <div class="invalid-feedback">
                            Enter Valid Title!
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="description">Description</label>
                        <textarea class="form-control" name="listing[description]" placeholder="Enter description"
                            required><%= detail.description %></textarea>

                        <div class="valid-feedback">
                            Validation Fulfilled!
                        </div>
                        <div class="invalid-feedback">
                            Enter Valid Description!
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="image">Image URL</label>
                        <input type="text" class="form-control" name="listing[image]"
                            placeholder="Enter image link/path" value="<%= detail.image %>" required>

                        <div class="valid-feedback">
                            Validation Fulfilled!
                        </div>
                        <div class="invalid-feedback">
                            Enter Valid Image URL!
                        </div>
                    </div>

                    <div class="row">

                        <div class="mb-3 col-md-4">
                            <label for="price">Price</label>
                            <input type="text" class="form-control" name="listing[price]" placeholder="Enter price"
                                value="<%= detail.price %>" required>

                            <div class="valid-feedback">
                                Validation Fulfilled!
                            </div>
                            <div class="invalid-feedback">
                                Enter Valid Price!
                            </div>
                        </div>

                        <div class="mb-3 col-md-8">
                            <label for="location">Location</label>
                            <input type="text" class="form-control" name="listing[location]"
                                placeholder="Enter location" value="<%= detail.location %>" required>

                            <div class="valid-feedback">
                                Validation Fulfilled!
                            </div>
                            <div class="invalid-feedback">
                                Enter Valid Location!
                            </div>
                        </div>

                    </div>

                    <div class="mb-3">
                        <label for="country">Country</label>
                        <input type="text" class="form-control" name="listing[country]" placeholder="Enter country"
                            value="<%= detail.country %>" required>

                        <div class="valid-feedback">
                            Validation Fulfilled!
                        </div>
                        <div class="invalid-feedback">
                            Enter Valid Country!
                        </div>
                    </div>

                    <button class="mt-3 mb-3 edit-btn">Update</button>

                </form>
            </div>
        </div>
    </body>