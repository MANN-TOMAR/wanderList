<% layout('/layouts/boilerplate.ejs') -%>

<div class="row mt-4 mb-4">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 mx-auto">
        <div class="card shadow-sm border-0 p-4 rounded-4 bg-white">
            <h2 class="fw-bold mb-1 text-center">Create Account</h2>
            <p class="text-muted text-center mb-4">Join Wanderlust to explore and host unique stays</p>

            <form action="/signup" method="post" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="username" class="form-label fw-semibold">Username</label>
                    <input type="text" id="username" name="signup[username]" placeholder="Choose a username" class="form-control form-control-lg fs-6" required>
                    <div class="invalid-feedback">Please choose a username.</div>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold">Email</label>
                    <input type="email" id="email" name="signup[email]" placeholder="name@example.com" class="form-control form-control-lg fs-6" required>
                    <div class="invalid-feedback">Please enter a valid email address.</div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label fw-semibold">Password</label>
                    <input type="password" id="password" name="signup[password]" placeholder="Create a password" class="form-control form-control-lg fs-6" required>
                    <div class="invalid-feedback">Please create a password.</div>
                </div>

                <button class="btn btn-dark add-btn w-100 py-2 fs-6 fw-semibold">Sign Up</button>
            </form>

            <div class="text-center mt-3 pt-3 border-top">
                <span class="text-muted small">Already have an account?</span>
                <a href="/login" class="text-decoration-none fw-semibold ms-1" style="color: #fe424d;">Log in</a>
            </div>
        </div>
    </div>
</div>
