<% layout('/layouts/boilerplate.ejs') -%>

    <body>
        <div class="row mt-3">
            <div class="col-6 offset-3">
                <h1>SignUp on WanderLust</h1>
                <br>
                <form action="/signup" method="post" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="title">Username</label>
                        <input type="text" name="signup[username]" placeholder="Enter username" class="form-control"
                            required>
                    </div>

                    <div class="mb-3">
                        <label for="description">Email</label>
                        <input type="email" name="signup[email]" placeholder="Enter Email" class="form-control"
                            required>
                    </div>

                    <div class="mb-3">
                        <label for="image">Password</label>
                        <input type="password" name="signup[password]" placeholder="Enter password"
                            class="form-control" required>
                    </div>
                    <button class="btn btn-dark mt-3 add-btn mb-3">Sign Up</button>
                </form>
            </div>
        </div>
    </body>