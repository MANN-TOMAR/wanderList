<%- layout('/layouts/boilerplate.ejs') %>

<div class="row mt-3">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">
        <h3 class="fw-bold mb-3"><%= detail.title %></h3>

        <div class="card show-card mb-4">
            <img src="<%= detail.image %>" class="show-img card-img-top shadow-sm mb-3" alt="<%= detail.title %>">
            <div class="card-body">
                <p class="text-muted mb-2">
                    <i class="fa-solid fa-user me-1"></i> Hosted by <b><%= detail.owner ? detail.owner.username : 'Host' %></b>
                </p>
                <p class="card-text fs-5 mb-3"><%= detail.description %></p>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="fs-4 fw-bold text-dark">&#x20B9;<%= detail.price.toLocaleString("en-IN") %></span>
                    <span class="text-muted">/ night</span>
                </div>
                <p class="text-secondary">
                    <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= detail.location %>, <%= detail.country %>
                </p>

                <% if(currentUser && detail.owner && currentUser._id.equals(detail.owner._id)) { %>
                    <div class="d-flex gap-2 mt-3 pt-3 border-top">
                        <a href="/listings/<%= detail._id %>/edit" class="btn edit-btn">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
                        </a>
                        <form action="/listings/<%= detail._id %>?_method=DELETE" method="post">
                            <button class="btn btn-dark">
                                <i class="fa-solid fa-trash me-1"></i> Delete
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>

        <hr class="my-4">

        <% if(currentUser) { %>
            <div class="mb-4">
                <h4 class="fw-bold mb-3">Leave a Review</h4>
                <form action="/listings/<%= detail._id %>/review" method="post" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="rating" class="form-label fw-semibold">Rating</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>

                    <div class="mb-3">
                        <label for="comment" class="form-label fw-semibold">Comments</label>
                        <textarea name="review[comment]" id="comment" class="form-control" rows="4" placeholder="Share your experience..." required></textarea>
                        <div class="invalid-feedback">Please share a brief comment for your review.</div>
                    </div>

                    <button class="btn btn-outline-dark">Submit Review</button>
                </form>
            </div>
            <hr class="my-4">
        <% } %>

        <div>
            <h4 class="fw-bold mb-3">Customer Reviews (<%= detail.reviews.length %>)</h4>
            <% if(detail.reviews.length === 0) { %>
                <p class="text-muted">No reviews yet. Be the first to leave a review!</p>
            <% } else { %>
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    <% for (review of detail.reviews) { %>
                        <div class="col">
                            <div class="card review-card h-100 p-3">
                                <div class="card-body p-0">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="card-title fw-bold mb-0">
                                            <i class="fa-solid fa-circle-user me-1 text-secondary"></i>
                                            <%= review.author ? review.author.username : 'Guest' %>
                                        </h6>
                                    </div>
                                    <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>"></p>
                                    <p class="card-text text-secondary mb-3"><%= review.comment %></p>
                                    <% if(currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                                        <form action="/listings/<%= detail._id %>/review/<%= review._id %>?_method=DELETE" method="post" class="mt-auto">
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</div>
