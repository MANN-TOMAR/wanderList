<%- layout('/layouts/boilerplate.ejs') %>

    <body>
        <div>
            <div class="row">
                <div class="col-8 offset-3 mt-3">
                    <h3>
                        <%= detail.title %>
                    </h3>
                </div>
                <div class="col-6 offset-3">
                    <div class="card listing-card">
                        <img src="<%= detail.image %>" class="card-img-top" alt="Listing Image"
                            style="height: 30vh;">
                        <div class="card-body">
                            <p class="card-text">
                            <p><i>Owned by <%= detail.owner.username %></i></p>
                            <%= detail.description %> <br>
                                &#x20B9;<%= detail.price.toLocaleString("en-IN") %>/night <br>
                                    <%= detail.location %>, <%= detail.country %> <br>
                                            </p>
                                            <% if(currentUser && currentUser._id.equals(detail.owner._id)) {%>
                                                <div class="btnn">
                                                    <a href="/listings/<%= detail._id %>/edit"
                                                        class="edit btn edit-btn">Edit</a>
                                                    <form action="/listings/<%= detail._id %>?_method=DELETE"
                                                        method="post">
                                                        <button class="btn btn-dark">Delete</button>
                                                    </form>
                                                </div>
                                                <% } %>
                                                    <hr>
                                                    <% if(currentUser) {%>
                                                        <h4>Leave a Review</h4>
                                                        <form action="/listings/<%= detail._id %>/review" method="post"
                                                            class="mt-3 mb-3 needs-validation" novalidate>
                                                            <div class="mb-3 mt-3">
                                                                <label for="rating" class="form-label">Rating</label>
                                                                <fieldset class="starability-slot">
                                                                    <input type="radio" id="no-rate"
                                                                        class="input-no-rate" name="review[rating]"
                                                                        value="1" checked aria-label="No rating." />
                                                                    <input type="radio" id="first-rate1"
                                                                        name="review[rating]" value="1" />
                                                                    <label for="first-rate1" title="Terrible">1
                                                                        star</label>
                                                                    <input type="radio" id="first-rate2"
                                                                        name="review[rating]" value="2" />
                                                                    <label for="first-rate2" title="Not good">2
                                                                        stars</label>
                                                                    <input type="radio" id="first-rate3"
                                                                        name="review[rating]" value="3" />
                                                                    <label for="first-rate3" title="Average">3
                                                                        stars</label>
                                                                    <input type="radio" id="first-rate4"
                                                                        name="review[rating]" value="4" />
                                                                    <label for="first-rate4" title="Very good">4
                                                                        stars</label>
                                                                    <input type="radio" id="first-rate5"
                                                                        name="review[rating]" value="5" />
                                                                    <label for="first-rate5" title="Amazing">5
                                                                        stars</label>
                                                                </fieldset>
                                                            </div>
                                                            <div class="mb-3 mt-3">
                                                                <label for="comment" class="form-label">Comments</label>
                                                                <textarea name="review[comment]" id="comment"
                                                                    class="form-control" required
                                                                    placeholder="Enter Review here" rows="5"></textarea>
                                                                <div class="valid-feedback">
                                                                    Validation Fulfilled!
                                                                </div>
                                                                <div class="invalid-feedback">
                                                                    Enter Valid Comment!
                                                                </div>
                                                            </div>
                                                            <button class="btn btn-outline-dark">ADD Review</button>
                                                        </form>
                                                        <hr>
                                                        <% } %>
                                                            <p><b>All Reviews</b></p>
                                                            <div class="reviews row">
                                                                <% for (review of detail.reviews) { %>
                                                                    <div class="card col-5 mb-3 ms-3">
                                                                        <h5 class="card-title">
                                                                            <%= review.author.username %>
                                                                        </h5>
                                                                        <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                                                                        <p class="card-text">
                                                                            <%= review.comment %>
                                                                        </p>
                                                                        <form
                                                                            action="/listings/<%= detail._id %>/review/<%= review._id %>?_method=DELETE"
                                                                            method="post" class="mb-3">
                                                                            <% if(currentUser &&
                                                                                review.author._id.equals(currentUser._id))
                                                                                {%>
                                                                                <button
                                                                                    class="btn btn-sm btn-dark">Delete</button>
                                                                                <% } %>
                                                                        </form>
                                                                    </div>
                                                                    <% } %>
                                                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>