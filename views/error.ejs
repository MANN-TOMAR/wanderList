<% layout('/layouts/boilerplate.ejs') -%>

<div class="row mt-4 mb-4">
    <div class="col-12 col-md-8 col-lg-6 mx-auto text-center">
        <div class="alert alert-danger shadow-sm p-4 rounded-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation display-4 text-danger mb-3 d-block"></i>
            <h4 class="alert-heading fw-bold">Oops! Something went wrong</h4>
            <p class="mb-3 text-secondary"><%= err.message || 'An unexpected error occurred.' %></p>
            <a href="/listings" class="btn btn-outline-danger">Return to Home</a>
        </div>
    </div>
</div>
